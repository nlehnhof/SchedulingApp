# Copy to .env.test.local (already gitignored, same as .env.local) and fill
# in with `npx supabase status` output after `npx supabase start` (requires
# Docker). Used ONLY by tests/integration/*.test.ts — never by the app
# itself, and never pointed at a real Supabase project. Running the
# concurrency suite fires real concurrent writes; pointing these at
# production would be destructive test data, not just a slow test.

TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_SERVICE_ROLE_KEY=
