# Database (Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/scheduling_app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (client auth + Calendar sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
# One-time, whole-app setup (not per client) — verify a domain in the Resend
# dashboard, then set this to an address on it. Until a domain is verified,
# Resend runs in sandbox mode and only delivers to your own account email,
# regardless of this address or who the app tries to send to — see
# lib/email.ts's header comment on sendBookingConfirmationEmail.
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Cron job auth (protect internal endpoints)
CRON_SECRET=

# --- Stripe billing (premium + elite tier subscriptions) ---
# STRIPE_PREMIUM_PRICE_ID / STRIPE_ELITE_PRICE_ID are the Price ids (not
# Product ids) of each recurring plan, created in the Stripe dashboard/test
# mode. Elite ($99/mo) unlocks multiple booking calendars + team access —
# see the 0013_elite_tier.sql migration; checkout for 'elite' 400s until
# STRIPE_ELITE_PRICE_ID is set. STRIPE_ELITE_EXTRA_CALENDAR_PRICE_ID is a
# separate $5/mo *quantity-based* recurring Price added as a second
# subscription item on the same subscription — it bills calendars 11-20 on
# an Elite plan (10 are included; 20 is a hard cap) — see
# app/api/client/calendars/route.ts and lib/stripe.ts's
# syncExtraCalendarQuantity. Adding/removing extra calendars silently no-ops
# on billing until this is set (same "configure later" pattern as the other
# two Price ids). For local testing, forward webhooks with the Stripe CLI:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# and use the signing secret it prints for STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_ELITE_PRICE_ID=
STRIPE_ELITE_EXTRA_CALENDAR_PRICE_ID=

# --- SMS reminders (premium feature, NOT YET IMPLEMENTED — see lib/sms.ts) ---
# app/api/cron/sms-reminders/route.ts checks these are all set before attempting
# anything, but lib/sms.ts has no real provider call wired up yet regardless —
# setting these alone will NOT start sending real texts. Left here so the cron
# route's "not configured" skip path can be exercised/tested.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Admin login (TESTING ONLY — do not enable for a real client deployment) ---
# Lets you sign into /dashboard with a username/password instead of Google OAuth,
# for clicking through the UI before a real Google Cloud OAuth app is set up.
# No refresh_token is attached to this login, so Google Calendar sync stays off
# for it. Leave ALLOW_ADMIN_LOGIN unset (or "false") once real clients are live.
ALLOW_ADMIN_LOGIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1
ADMIN_EMAIL=admin@local.test
