# Database (Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/scheduling_app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (client auth + Calendar sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=

# Cron job auth (protect internal endpoints)
CRON_SECRET=

# --- Admin login (TESTING ONLY — do not enable for a real client deployment) ---
# Lets you sign into /dashboard with a username/password instead of Google OAuth,
# for clicking through the UI before a real Google Cloud OAuth app is set up.
# No refresh_token is attached to this login, so Google Calendar sync stays off
# for it. Leave ALLOW_ADMIN_LOGIN unset (or "false") once real clients are live.
ALLOW_ADMIN_LOGIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1
ADMIN_EMAIL=admin@local.test
